{
  "name": "isys-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:android": "vite build --base ./",
    "android:sync": "npm run android:prepare && npx cap sync android",
    "android:prepare": "npm run build:android && node scripts/prepare-android.mjs",
    "android:studio:init": "npm run android:prepare && npx cap add android && npx cap open android",
    "android:studio": "npx cap open android",
    "android:run": "npm run android:sync && npx cap run android"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0",
    "xlsx": "^0.18.5",
    "html2pdf.js": "^0.10.3",
    "qrcode": "^1.5.4",
    "@zxing/browser": "^0.1.5",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.4",
    "@capacitor/core": "^7.4.0",
    "@capacitor/status-bar": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.0",
    "@capacitor/android": "^7.4.0"
  }
}
